{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipBeam",
  "version": "0.1.0",
  "identifier": "com.clipbeam.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipBeam",
        "width": 720,
        "height": 880,
        "resizable": true,
        "visible": false,
        "hiddenTitle": true
      },
      {
        "label": "scripting",
        "title": "ClipBeam 脚本",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "hiddenTitle": true,
        "url": "index.html#/scripting"
      },
      {
        "label": "progress",
        "title": "ClipBeam 任务进度",
        "width": 420,
        "height": 96,
        "resizable": false,
        "visible": false,
        "hiddenTitle": true,
        "url": "index.html#/progress",
        "alwaysOnTop": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "shadow": true,
        "acceptFirstMouse": true
      },
      {
        "label": "standby",
        "title": "ClipBeam 待命",
        "width": 320,
        "height": 250,
        "resizable": false,
        "visible": false,
        "hiddenTitle": false,
        "url": "index.html#/standby",
        "alwaysOnTop": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "decorations": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
