{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipBeam",
  "version": "0.1.0",
  "identifier": "com.clipbeam.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../frontend"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipBeam",
        "width": 720,
        "height": 880,
        "resizable": true,
        "visible": false,
        "hiddenTitle": true
      },
      {
        "label": "progress",
        "title": "ClipBeam 任务进度",
        "width": 480,
        "height": 280,
        "resizable": false,
        "visible": false,
        "hiddenTitle": true,
        "url": "index.html#/progress",
        "alwaysOnTop": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
